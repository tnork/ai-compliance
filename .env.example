# Copy to `.env` (scripts) and `web/.env.local` (Next.js app). Never commit real values.

# ── Supabase (Project Settings → API) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key BYPASSES row-level security. Server-side only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Browser-safe values used by the Next.js app (publishable key respects RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Database (Project Settings → Database) — used by scripts/migrate.mjs ────
SUPABASE_DB_PASSWORD=
# IPv4-only networks: use the session pooler instead of the direct (IPv6) host.
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PORT=5432
# Path to the Supabase CA cert to verify TLS (otherwise encrypted but unverified).
# SUPABASE_CA_CERT=

# ── App ────────────────────────────────────────────────────────────────────
# Where invite / recovery email links land. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=
# Username of the admin app_user that scripts/save-policy.mjs saves under.
ADMIN_USERNAME=admin

# ── Optional ───────────────────────────────────────────────────────────────
# Enterprise API connectors: 32 random bytes, base64 (openssl rand -base64 32).
CONNECTOR_ENC_KEY=
# Shared secret your scheduler sends as the x-cron-secret header to POST /api/cron/sync-connectors.
CRON_SECRET=
# Billing. Without it, plan selection is recorded and checkout is skipped.
STRIPE_SECRET_KEY=
